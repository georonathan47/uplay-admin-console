# Supabase project this console reads from.
# Copy to .env and fill in. Both values are safe to expose in a browser bundle —
# every request is still evaluated by row level security as the signed-in admin.

# Project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) from Project Settings → API Keys.
VITE_SUPABASE_ANON_KEY=
